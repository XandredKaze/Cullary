{
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "name": "cullary",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "version": "0.2.1",
  "build": {
    "appId": "com.cullary.app",
    "productName": "Cullary",
    "files": [
      "*.js",
      "*.html",
      "*.css"
    ],
    "extraResources": [
      {
        "from": "../native/apploopback.exe",
        "to": "apploopback.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cullary",
      "artifactName": "Cullary-Setup.exe"
    }
  }
}
